#!/bin/bash

## Copyright (C) 2024 - 2025 ENCRYPTED SUPPORT LLC <adrelanos@whonix.org>
## See the file COPYING for copying conditions.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose

/usr/libexec/helper-scripts/try-wait-for-tor-service-running || true

## style-ok: allow-exec -- this is a qrexec RPC service: socat must BECOME
## the process wired to the RPC stdio channel, so replacing this shell is
## the point rather than an optimisation.
exec socat STDIO TCP:127.0.0.1:8082
